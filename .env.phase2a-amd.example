# Copy values into .env or pass them inline when using the amd compose profile.

# Override this if your AMD host uses a different validated ROCm container tag.
AMD_BASE_IMAGE=rocm/dev-ubuntu-24.04:7.2.2-complete

# Host path to a MIGraphX-enabled ONNX Runtime installation.
# It must contain include/onnxruntime_cxx_api.h and lib/libonnxruntime.so.
ONNXRUNTIME_ROOT_HOST=./third_party/onnxruntime

# Set to 1 only when ros-${ROS_DISTRO}-ros2-benchmark is available in your apt repos.
INSTALL_BENCHMARK_DEPS=0

ROS_DISTRO=jazzy
