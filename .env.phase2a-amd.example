# Copy values into .env or pass them inline when using the amd compose profile.

# Phase 1 used ORT 1.23.1. AMD supports it with ROCm 7.1/7.1.1.
AMD_BASE_IMAGE=rocm/dev-ubuntu-24.04:7.1.1-complete
ORT_VERSION=1.23.1

# Limit ORT source-build parallelism for smaller development machines.
ORT_BUILD_JOBS=16

# Set to 1 only when ros-${ROS_DISTRO}-ros2-benchmark is available in your apt repos.
INSTALL_BENCHMARK_DEPS=0

ROS_DISTRO=jazzy
