<?xml version="1.0"?>
<package format="3">
  <name>isaac_ros_onnx_inference</name>
  <version>0.1.0</version>
  <description>Vendor-neutral ONNX Runtime inference node for ROS2 (CUDA/ROCm/MIGraphX/CPU EP)</description>

  <maintainer email="maintainer@example.com">Maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>isaac_ros_tensor_list_interfaces</depend>
  <depend>gpu_ros_managed_core</depend>
  <depend>gpu_ros_managed_ros</depend>
  <depend>gpu_ros_managed_tensor_list</depend>
  <build_depend>gpu_ros_managed_cuda</build_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
