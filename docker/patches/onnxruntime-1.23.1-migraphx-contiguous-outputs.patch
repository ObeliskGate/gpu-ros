+void copy_migraphx_output_to_contiguous(const migraphx::argument& source,
+                                        const migraphx::shape& layout,
+                                        void* destination,
+                                        hipStream_t stream) {
+  const auto& shape = layout;
+  if (shape.standard()) {
+    HIP_CALL_THROW(hipMemcpyWithStream(destination,
+                                       source.data(),
+                                       shape.bytes(),
+                                       hipMemcpyDeviceToDevice,
+                                       stream));
+    return;
+  }
+
+  const auto elements = shape.elements();
+  if (elements == 0) {
+    return;
+  }
+
+  const auto storage_bytes = shape.bytes();
+  ORT_ENFORCE(storage_bytes % elements == 0,
+              "MIGraphX output storage size is not divisible by its element count");
+
+  // ORT exposes graph outputs as contiguous tensors. The MIGraphX public API
+  // provides the physical offset for each logical element, so packed
+  // transposed outputs can be normalized without depending on internal IR
+  // headers. Reject padded or broadcast layouts instead of copying beyond the
+  // ORT output allocation.
+  std::vector<std::size_t> physical_indices(elements);
+  std::vector<bool> seen(elements, false);
+  for (std::size_t i = 0; i < elements; ++i) {
+    const auto physical_index = shape.index(i);
+    ORT_ENFORCE(physical_index < elements,
+                "MIGraphX produced a non-packed output layout that cannot be bound to an ORT output tensor");
+    ORT_ENFORCE(!seen[physical_index],
+                "MIGraphX produced a broadcast output layout that cannot be bound to an ORT output tensor");
+    seen[physical_index] = true;
+    physical_indices[i] = physical_index;
+  }
+
+  const auto element_bytes = storage_bytes / elements;
+  std::vector<std::uint8_t> source_host(storage_bytes);
+  std::vector<std::uint8_t> contiguous_host(storage_bytes);
+
+  HIP_CALL_THROW(hipStreamSynchronize(stream));
+  HIP_CALL_THROW(hipMemcpy(source_host.data(),
+                           source.data(),
+                           storage_bytes,
+                           hipMemcpyDeviceToHost));
+  for (std::size_t i = 0; i < elements; ++i) {
+    std::memcpy(contiguous_host.data() + i * element_bytes,
+                source_host.data() + physical_indices[i] * element_bytes,
+                element_bytes);
+  }
+  HIP_CALL_THROW(hipMemcpy(destination,
+                           contiguous_host.data(),
+                           storage_bytes,
+                           hipMemcpyHostToDevice));
+}
