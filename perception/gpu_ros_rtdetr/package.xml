<?xml version="1.0"?>
<package format="3">
  <name>gpu_ros_rtdetr</name>
  <version>0.1.0</version>
  <description>RT-DETR preprocessor and decoder nodes using standard ROS2 TensorBundle (vendor-neutral, no NITROS)</description>

  <maintainer email="unnamets@gmail.com">Boshen Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>vision_msgs</depend>
  <depend>gpu_ros_tensor_bundle_msgs</depend>
  <depend>libopencv-dev</depend>
  <depend>gpu_ros_detection_common</depend>
  <depend>gpu_ros_managed_core</depend>
  <depend>gpu_ros_managed_hip</depend>
  <depend>gpu_ros_managed_ros</depend>
  <depend>gpu_ros_managed_tensor_bundle</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>gpu_ros_onnx_inference</test_depend>
  <test_depend>python3-onnx</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
