def digest(path: Path) -> str:
    sha = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            sha.update(chunk)
    return sha.hexdigest()


def yolo_model_path() -> Path:
    return ASSETS_ROOT / YOLOV8_MODEL_REL


def _is_yolov8_entry(entry: dict[str, Any]) -> bool:
    path = str(entry.get("path", ""))
    return entry.get("asset_kind") == "yolov8" or path == str(YOLOV8_MODEL_REL)


def _required_manifest_entries(data: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        entry
        for entry in data.get("files", [])
        if isinstance(entry, dict) and not _is_yolov8_entry(entry)
    ]


