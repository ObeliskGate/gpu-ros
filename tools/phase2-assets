def _write_manifest_atomically(payload: dict[str, Any]) -> None:
    ASSETS_ROOT.mkdir(parents=True, exist_ok=True)
    temporary = MANIFEST.with_suffix(".json.partial")
    temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
    temporary.replace(MANIFEST)


def _shape_from_onnx_value_info(value_info: Any) -> list[int | str | None]:
    tensor_type = value_info.type.tensor_type
    shape = tensor_type.shape
    dimensions: list[int | str | None] = []
    for dimension in shape.dim:
        if dimension.HasField("dim_value"):
            dimensions.append(int(dimension.dim_value))
        elif dimension.HasField("dim_param"):
            dimensions.append(str(dimension.dim_param))
        else:
            dimensions.append(None)
    return dimensions


def _require_known_shape_dimension(
    shape: list[int | str | None],
    index: int,
    expected: int,
    label: str,
    *,
    allow_symbolic: bool = False,
) -> None:
    if len(shape) <= index:
        actual = shape
    else:
        actual = shape[index]
    if actual is None or (allow_symbolic and isinstance(actual, str)):
        return
    if actual != expected:
        raise RuntimeError(
            f"RT-DETR ONNX {label} shape mismatch: expected dimension {index} "
            f"to be {expected}, got {shape}"
        )


def _validate_rtdetr_with_onnx(path: Path) -> None:
    try:
        import onnx  # type: ignore[import-not-found]
    except ImportError:
        _validate_rtdetr_with_onnxruntime(path)
        return

    try:
        model = onnx.load(str(path), load_external_data=False)
        onnx.checker.check_model(model)
    except Exception as error:
        raise RuntimeError(f"RT-DETR ONNX model is not readable: {path}: {error}") from error

    graph = model.graph
    expected_inputs = RTDETR_MODEL_IDENTITY["input_names"]
    expected_outputs = RTDETR_MODEL_IDENTITY["output_names"]
    if [value_info.name for value_info in graph.input] != expected_inputs:
        raise RuntimeError(
            "RT-DETR ONNX input contract mismatch: expected "
            f"{expected_inputs}, got {[value_info.name for value_info in graph.input]}"
        )
    if [value_info.name for value_info in graph.output] != expected_outputs:
        raise RuntimeError(
            "RT-DETR ONNX output contract mismatch: expected "
            f"{expected_outputs}, got {[value_info.name for value_info in graph.output]}"
        )

    input_types = [value_info.type.tensor_type.elem_type for value_info in graph.input]
    if input_types != [onnx.TensorProto.FLOAT, onnx.TensorProto.INT64]:
        raise RuntimeError(
            "RT-DETR ONNX input dtype mismatch: expected float32/int64, "
            f"got {input_types}"
        )
    output_types = [value_info.type.tensor_type.elem_type for value_info in graph.output]
    if output_types != [onnx.TensorProto.INT64, onnx.TensorProto.FLOAT, onnx.TensorProto.FLOAT]:
        raise RuntimeError(
            "RT-DETR ONNX output dtype mismatch: expected int64/float32/float32, "
            f"got {output_types}"
        )

    input_shapes = [_shape_from_onnx_value_info(value_info) for value_info in graph.input]
    output_shapes = [_shape_from_onnx_value_info(value_info) for value_info in graph.output]
    if len(input_shapes[0]) != 4 or len(input_shapes[1]) != 2:
        raise RuntimeError(f"RT-DETR ONNX input rank mismatch: got {input_shapes}")
    _require_known_shape_dimension(input_shapes[0], 1, 3, "images")
    _require_known_shape_dimension(input_shapes[0], 2, 640, "images")
    _require_known_shape_dimension(input_shapes[0], 3, 640, "images")
    _require_known_shape_dimension(input_shapes[1], 1, 2, "orig_target_sizes")
    if len(output_shapes) != 3 or [len(shape) for shape in output_shapes] != [2, 3, 2]:
        raise RuntimeError(f"RT-DETR ONNX output rank mismatch: got {output_shapes}")
    # The pinned RT-DETRv2 export can describe postprocessor dimensions with
    # symbolic names such as Sublabels_dim_*. The application contract and
    # decoder still require the concrete runtime shapes [1,300], [1,300,4],
    # and [1,300]; symbolic ONNX metadata is not itself a contract mismatch.
    _require_known_shape_dimension(
        output_shapes[0], 1, 300, "labels", allow_symbolic=True)
    _require_known_shape_dimension(
        output_shapes[1], 1, 300, "boxes", allow_symbolic=True)
    _require_known_shape_dimension(output_shapes[1], 2, 4, "boxes")
    _require_known_shape_dimension(
        output_shapes[2], 1, 300, "scores", allow_symbolic=True)

    default_opsets = [
        int(opset.version) for opset in model.opset_import if opset.domain in ("", "ai.onnx")
    ]
    if RTDETR_MODEL_IDENTITY["export_opset"] not in default_opsets:
        raise RuntimeError(
            "RT-DETR ONNX opset mismatch: expected opset 16, "
            f"got {default_opsets}"
        )


def _validate_rtdetr_with_onnxruntime(path: Path) -> None:
    try:
        import onnxruntime  # type: ignore[import-not-found]
    except ImportError as error:
        raise RuntimeError(
            "cannot read RT-DETR ONNX model: install python3-onnx or "
            "onnxruntime before running asset verification"
        ) from error
    try:
        session = onnxruntime.InferenceSession(str(path), providers=["CPUExecutionProvider"])
        inputs = session.get_inputs()
        outputs = session.get_outputs()
    except Exception as error:
        raise RuntimeError(f"RT-DETR ONNX model is not readable: {path}: {error}") from error

    if [item.name for item in inputs] != RTDETR_MODEL_IDENTITY["input_names"]:
        raise RuntimeError(
            "RT-DETR ONNX input contract mismatch: got "
            f"{[(item.name, item.shape, item.type) for item in inputs]}"
        )
    if [item.name for item in outputs] != RTDETR_MODEL_IDENTITY["output_names"]:
        raise RuntimeError(
            "RT-DETR ONNX output contract mismatch: got "
            f"{[(item.name, item.shape, item.type) for item in outputs]}"
        )
    if [item.type for item in inputs] != ["tensor(float)", "tensor(int64)"]:
        raise RuntimeError("RT-DETR ONNX input dtype mismatch: expected float32/int64")
    if [item.type for item in outputs] != ["tensor(int64)", "tensor(float)", "tensor(float)"]:
        raise RuntimeError("RT-DETR ONNX output dtype mismatch: expected int64/float32/float32")
    input_shapes = [list(item.shape) for item in inputs]
    output_shapes = [list(item.shape) for item in outputs]
    if len(input_shapes[0]) != 4 or len(input_shapes[1]) != 2:
        raise RuntimeError(f"RT-DETR ONNX input rank mismatch: got {input_shapes}")
    _require_known_shape_dimension(input_shapes[0], 1, 3, "images")
    _require_known_shape_dimension(input_shapes[0], 2, 640, "images")
    _require_known_shape_dimension(input_shapes[0], 3, 640, "images")
    _require_known_shape_dimension(input_shapes[1], 1, 2, "orig_target_sizes")
    if len(output_shapes) != 3 or [len(shape) for shape in output_shapes] != [2, 3, 2]:
        raise RuntimeError(f"RT-DETR ONNX output rank mismatch: got {output_shapes}")
    _require_known_shape_dimension(
        output_shapes[0], 1, 300, "labels", allow_symbolic=True)
    _require_known_shape_dimension(
        output_shapes[1], 1, 300, "boxes", allow_symbolic=True)
    _require_known_shape_dimension(output_shapes[1], 2, 4, "boxes")
    _require_known_shape_dimension(
        output_shapes[2], 1, 300, "scores", allow_symbolic=True)


def validate_rtdetr_model(path: Path) -> str:
    if not path.is_file():
        raise RuntimeError(f"RT-DETRv2 ONNX asset is missing: {path}")
    _validate_rtdetr_with_onnx(path)
    return digest(path)


def _validate_yolov8_with_onnx(path: Path) -> None:
    try:
        import onnx  # type: ignore[import-not-found]
    except ImportError:
        _validate_yolov8_with_onnxruntime(path)
        return

    try:
        model = onnx.load(str(path), load_external_data=False)
        onnx.checker.check_model(model)
    except Exception as error:
        raise RuntimeError(f"YOLOv8 ONNX model is not readable: {path}: {error}") from error

    graph = model.graph
    if len(graph.input) != 1 or graph.input[0].name != YOLOV8_MODEL_IDENTITY["input_name"]:
        names = [value_info.name for value_info in graph.input]
        raise RuntimeError(
            "YOLOv8 ONNX input contract mismatch: expected only input 'images', "
            f"got {names}"
        )
    input_shape = _shape_from_onnx_value_info(graph.input[0])
    if input_shape != YOLOV8_MODEL_IDENTITY["input_shape"]:
        raise RuntimeError(
            "YOLOv8 ONNX input shape mismatch: expected "
            f"{YOLOV8_MODEL_IDENTITY['input_shape']}, got {input_shape}"
        )
    if graph.input[0].type.tensor_type.elem_type != onnx.TensorProto.FLOAT:
        raise RuntimeError("YOLOv8 ONNX input contract mismatch: expected float32 input")

    if len(graph.output) != 1 or graph.output[0].name != YOLOV8_MODEL_IDENTITY["output_name"]:
        names = [value_info.name for value_info in graph.output]
        raise RuntimeError(
            "YOLOv8 ONNX output contract mismatch: expected only output 'output0', "
            f"got {names}"
        )
    output_shape = _shape_from_onnx_value_info(graph.output[0])
    if output_shape != YOLOV8_MODEL_IDENTITY["output_shape"]:
        raise RuntimeError(
            "YOLOv8 ONNX output shape mismatch: expected "
            f"{YOLOV8_MODEL_IDENTITY['output_shape']}, got {output_shape}"
        )
    if graph.output[0].type.tensor_type.elem_type != onnx.TensorProto.FLOAT:
        raise RuntimeError("YOLOv8 ONNX output contract mismatch: expected float32 output")

    default_opsets = [
        int(opset.version) for opset in model.opset_import if opset.domain in ("", "ai.onnx")
    ]
    if YOLOV8_MODEL_IDENTITY["opset_version"] not in default_opsets:
        raise RuntimeError(
            "YOLOv8 ONNX opset mismatch: expected opset 17, "
            f"got {default_opsets}"
        )
    if any(
        node.op_type == "NonMaxSuppression" or "NMS" in node.op_type.upper()
        for node in graph.node
    ):
        raise RuntimeError("YOLOv8 ONNX output contract mismatch: built-in NMS is not allowed")


def _validate_yolov8_with_onnxruntime(path: Path) -> None:
    try:
        import onnxruntime  # type: ignore[import-not-found]
    except ImportError as error:
        raise RuntimeError(
            "cannot read YOLOv8 ONNX model: install the runtime's python3-onnx "
            "or onnxruntime package before running asset verification"
        ) from error

    try:
        session = onnxruntime.InferenceSession(
            str(path), providers=["CPUExecutionProvider"]
        )
        inputs = session.get_inputs()
        outputs = session.get_outputs()
    except Exception as error:
        raise RuntimeError(f"YOLOv8 ONNX model is not readable: {path}: {error}") from error

    input_shape = list(inputs[0].shape) if len(inputs) == 1 else []
    output_shape = list(outputs[0].shape) if len(outputs) == 1 else []
    if (
        len(inputs) != 1
        or inputs[0].name != YOLOV8_MODEL_IDENTITY["input_name"]
        or input_shape != YOLOV8_MODEL_IDENTITY["input_shape"]
        or inputs[0].type != "tensor(float)"
    ):
        raise RuntimeError(
            "YOLOv8 ONNX input contract mismatch: expected input 'images' with shape "
            f"{YOLOV8_MODEL_IDENTITY['input_shape']}, got "
            f"{[(item.name, item.shape) for item in inputs]}"
        )
    if (
        len(outputs) != 1
        or outputs[0].name != YOLOV8_MODEL_IDENTITY["output_name"]
        or output_shape != YOLOV8_MODEL_IDENTITY["output_shape"]
        or outputs[0].type != "tensor(float)"
    ):
        raise RuntimeError(
            "YOLOv8 ONNX output contract mismatch: expected output 'output0' with shape "
            f"{YOLOV8_MODEL_IDENTITY['output_shape']}, got "
            f"{[(item.name, item.shape) for item in outputs]}"
        )


def validate_yolov8_model(path: Path) -> str:
    if not path.is_file():
        raise RuntimeError(f"YOLOv8 ONNX asset is missing: {path}")
    model_sha256 = digest(path)
    if model_sha256 != YOLOV8_MODEL_SHA256:
        raise RuntimeError(
            "YOLOv8 ONNX SHA-256 mismatch: "
            f"{model_sha256}; expected {YOLOV8_MODEL_SHA256}"
        )
    _validate_yolov8_with_onnx(path)
    return model_sha256


