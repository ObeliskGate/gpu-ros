        }
    if profile == "xanylabeling_rtdetrv2_r50":
        return {
            "bytes_distributor": (
                "X-AnyLabeling v2.4.0 release: https://github.com/CVHub520/"
                "X-AnyLabeling/releases/download/v2.4.0/rtdetrv2_r50vd_6x_coco.onnx"
