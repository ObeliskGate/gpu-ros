def shape(value_info: Any) -> list[int | str | None]:
    result: list[int | str | None] = []
    for dimension in value_info.type.tensor_type.shape.dim:
        if dimension.HasField("dim_value"):
            result.append(int(dimension.dim_value))
        elif dimension.HasField("dim_param"):
            result.append(str(dimension.dim_param))
        else:
            result.append(None)
    return result


def validate_rtdetr(path: Path) -> str:
    if not path.is_file():
        raise RuntimeError(f"selected model asset is missing: {path}")
    try:
        import onnx  # type: ignore[import-not-found]
    except ImportError:
        project = REPOSITORY_ROOT / "tools/rtdetrv2-export"
        environment = os.environ.copy()
        environment.update(
            {
                "UV_OFFLINE": "1",
                "UV_PROJECT_ENVIRONMENT": os.environ.get(
                    "OVG_RTDETR_EXPORT_VENV", str(CACHE_ROOT / "rtdetrv2-export-venv")
                ),
            }
        )
        result = subprocess.run(
            [
                "uv", "run", "--frozen", "--project", str(project),
                str(Path(__file__).resolve()), "_validate-rtdetr", "--source", str(path),
            ],
            check=True,
            capture_output=True,
            text=True,
            env=environment,
        )
        return result.stdout.strip().splitlines()[-1]
    model = onnx.load(str(path), load_external_data=False)
    onnx.checker.check_model(model)
    inputs = list(model.graph.input)
    outputs = list(model.graph.output)
    if [item.name for item in inputs] != ["images", "orig_target_sizes"]:
        raise RuntimeError("RT-DETR input names do not match images/orig_target_sizes")
    if [item.name for item in outputs] != ["labels", "boxes", "scores"]:
        raise RuntimeError("RT-DETR output names do not match labels/boxes/scores")
    if [item.type.tensor_type.elem_type for item in inputs] != [
        onnx.TensorProto.FLOAT,
        onnx.TensorProto.INT64,
    ]:
        raise RuntimeError("RT-DETR input dtypes do not match float32/int64")
    if [item.type.tensor_type.elem_type for item in outputs] != [
        onnx.TensorProto.INT64,
        onnx.TensorProto.FLOAT,
        onnx.TensorProto.FLOAT,
    ]:
        raise RuntimeError("RT-DETR output dtypes do not match int64/float32/float32")
    input_shapes = [shape(item) for item in inputs]
    if len(input_shapes[0]) != 4 or input_shapes[0][1:] != [3, 640, 640]:
        raise RuntimeError(f"RT-DETR image shape must be [N,3,640,640], got {input_shapes[0]}")
    if len(input_shapes[1]) != 2 or input_shapes[1][1] != 2:
        raise RuntimeError(f"RT-DETR target size shape must be [N,2], got {input_shapes[1]}")
    opsets = [item.version for item in model.opset_import if item.domain in ("", "ai.onnx")]
    if 16 not in opsets:
        raise RuntimeError(f"RT-DETR default-domain opset must be 16, got {opsets}")
    return digest(path)


def selected_profile(requested: str, provider: str) -> str:
    if requested != "auto":
        return requested
    return "nvidia_synthetica" if provider == "cuda" else "rtdetrv2_r50"


def model_record(profile: str) -> dict[str, Any]:
    path = ASSETS_ROOT / MODEL_PATHS[profile]
    record = profile_evidence(profile)
    record.update({"profile": profile, "path": str(MODEL_PATHS[profile])})
    if path.is_file():
        record.update({"sha256": digest(path), "size_bytes": path.stat().st_size})
    else:
        record.update({"sha256": None, "size_bytes": None})
    return record


def write_manifest(profile: str) -> None:
    dataset = ASSETS_ROOT / DATASET_REL
    payload = {
        "schema_version": 3,
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "selected_model_profile": profile,
        "models": {name: model_record(name) for name in MODEL_PATHS},
        "dataset": {
            "path": str(DATASET_REL),
            "tree_sha256": tree_digest(dataset) if dataset.is_dir() else None,
            "license": "NOASSERTION; user-provided external dataset",
            "redistributable_with_source_release": False,
        },
    }
    write_json(MANIFEST, payload)


def status(_: argparse.Namespace) -> None:
    print(f"assets root: {ASSETS_ROOT}")
    for name, relative in MODEL_PATHS.items():
        path = ASSETS_ROOT / relative
        state = f"present sha256={digest(path)}" if path.is_file() else "missing"
        print(f"model {name}: {state} ({path})")
    dataset = ASSETS_ROOT / DATASET_REL
    print(f"dataset r2b: {'present' if dataset.is_dir() else 'missing'} ({dataset})")


def prepare(args: argparse.Namespace) -> None:
    profile = selected_profile(args.model_profile, args.execution_provider)
    model = ASSETS_ROOT / MODEL_PATHS[profile]
    if not model.is_file():
        raise RuntimeError(
            f"selected profile {profile} is missing at {model}; import or build that exact "
            "profile (automatic fallback is forbidden)"
        )
    if profile in ("rtdetrv2_r50", "xanylabeling_rtdetrv2_r50"):
        found = validate_rtdetr(model)
        expected = FORMAL_ONNX_SHA256 if profile == "rtdetrv2_r50" else XANYLABELING_SHA256
        if expected and found != expected:
            raise RuntimeError(f"{profile} SHA-256 mismatch: expected {expected}, got {found}")
    dataset = ASSETS_ROOT / DATASET_REL
    if not dataset.is_dir():
        raise RuntimeError(f"R2B dataset is missing: {dataset}")
    write_manifest(profile)
    print(f"validated model_profile={profile}: {model}")
    print(f"validated dataset: {dataset}")


def import_model(args: argparse.Namespace) -> None:
    source = args.source.resolve()
    if not source.is_file():
        raise RuntimeError(f"model source is not a file: {source}")
    found = digest(source)
    if args.profile == "xanylabeling_rtdetrv2_r50" and found != XANYLABELING_SHA256:
        raise RuntimeError(
            f"X-AnyLabeling v2.4.0 SHA-256 mismatch: expected {XANYLABELING_SHA256}, got {found}"
        )
    if args.profile == "rtdetrv2_r50" and found != FORMAL_ONNX_SHA256:
        raise RuntimeError(
            f"formal RT-DETRv2 SHA-256 mismatch: expected {FORMAL_ONNX_SHA256}, got {found}; "
            "use build-rtdetrv2-r50 for the locked local export"
        )
    if args.profile in ("rtdetrv2_r50", "xanylabeling_rtdetrv2_r50"):
        validate_rtdetr(source)
    destination = ASSETS_ROOT / MODEL_PATHS[args.profile]
    atomic_copy(source, destination)
    write_manifest(args.profile)
    print(f"imported {args.profile}: {destination} sha256={found}")


def import_r2b(args: argparse.Namespace) -> None:
    source = args.source.resolve()
    if not source.is_dir():
        raise RuntimeError(f"R2B source is not a directory: {source}")
    destination = ASSETS_ROOT / DATASET_REL
    if destination.exists():
        raise RuntimeError(f"refusing to overwrite existing dataset: {destination}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    partial = destination.with_name(destination.name + ".partial")
    if partial.exists():
        raise RuntimeError(f"remove incomplete prior import first: {partial}")
    shutil.copytree(source, partial, symlinks=True)
    partial.replace(destination)
    print(f"imported R2B dataset: {destination} tree_sha256={tree_digest(destination)}")


def run_export(upstream: Path, checkpoint: Path, output: Path) -> list[str]:
    project = REPOSITORY_ROOT / "tools/rtdetrv2-export"
    wrapper = project / "run_export.py"
    official_config = (
        upstream / "rtdetrv2_pytorch/configs/rtdetrv2/rtdetrv2_r50vd_6x_coco.yml"
    )
    config = output.parent / "offline_export_config.yml"
    config.write_text(
        "__include__:\n"
        f"  - {json.dumps(str(official_config))}\n"
        "PResNet:\n"
        "  pretrained: false\n"
    )
    script = upstream / "rtdetrv2_pytorch/tools/export_onnx.py"
    command = [
        "uv", "run", "--frozen", "--project", str(project), str(wrapper),
        "--upstream-script", str(script), "--config", str(config),
        "--resume", str(checkpoint), "--output_file", str(output), "--check",
    ]
    environment = os.environ.copy()
    environment.update(
        {
            "PYTHONHASHSEED": "0",
            "SOURCE_DATE_EPOCH": "0",
            "TORCH_HOME": str(CACHE_ROOT / "torch"),
            "UV_OFFLINE": "1",
            "UV_PROJECT_ENVIRONMENT": os.environ.get(
                "OVG_RTDETR_EXPORT_VENV", str(CACHE_ROOT / "rtdetrv2-export-venv")
            ),
        }
    )
    subprocess.run(
        command,
        cwd=upstream / "rtdetrv2_pytorch",
        env=environment,
        check=True,
    )
    return command


def build_rtdetr(args: argparse.Namespace) -> None:
    upstream = args.upstream_dir.resolve()
    checkpoint = args.checkpoint.resolve()
    if not (upstream / ".git").exists():
        raise RuntimeError(f"upstream directory is not a Git checkout: {upstream}")
    head = subprocess.run(
        ["git", "-C", str(upstream), "rev-parse", "HEAD"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    if head != UPSTREAM_COMMIT:
        raise RuntimeError(f"RT-DETR checkout mismatch: expected {UPSTREAM_COMMIT}, got {head}")
    if not checkpoint.is_file():
        raise RuntimeError(f"checkpoint is missing: {checkpoint}")
    checkpoint_hash = digest(checkpoint)
    if checkpoint_hash != CHECKPOINT_SHA256:
        raise RuntimeError(
            f"checkpoint SHA-256 mismatch: expected {CHECKPOINT_SHA256}, got {checkpoint_hash}"
        )
    destination = ASSETS_ROOT / MODEL_PATHS["rtdetrv2_r50"]
    if destination.exists():
        raise RuntimeError(f"refusing to overwrite existing formal model: {destination}")
    CACHE_ROOT.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="rtdetrv2-export-", dir=CACHE_ROOT) as temporary:
        work = Path(temporary)
        first = work / "first.onnx"
        second = work / "second.onnx"
        command = run_export(upstream, checkpoint, first)
        first_hash = validate_rtdetr(first)
        command = run_export(upstream, checkpoint, second)
        second_hash = validate_rtdetr(second)
        if first_hash != second_hash:
            raise RuntimeError(
                "locked RT-DETRv2 export is not byte reproducible: "
                f"first={first_hash}, second={second_hash}"
            )
        if FORMAL_ONNX_SHA256 and first_hash != FORMAL_ONNX_SHA256:
            raise RuntimeError(
                f"formal ONNX SHA-256 mismatch: expected {FORMAL_ONNX_SHA256}, got {first_hash}"
            )
        atomic_copy(first, destination)
    lock = REPOSITORY_ROOT / "tools/rtdetrv2-export/uv.lock"
    provenance = profile_evidence("rtdetrv2_r50")
    provenance.update(
        {
            "upstream_commit": head,
            "checkpoint_sha256": checkpoint_hash,
            "uv_lock_sha256": digest(lock),
            "first_export_sha256": first_hash,
            "second_export_sha256": second_hash,
            "command": command,
            "config_override": {
                "PResNet.pretrained": False,
                "reason": (
                    "the complete EMA checkpoint supplies all model parameters; disable the "
                    "configuration's redundant network fetch before loading that checkpoint"
                ),
            },
            "generated_at": datetime.now(timezone.utc).isoformat(),
        }
    )
    write_json(destination.with_suffix(".provenance.json"), provenance)
    write_manifest("rtdetrv2_r50")
    print(f"built reproducible rtdetrv2_r50: {destination} sha256={first_hash}")


def validate_command(args: argparse.Namespace) -> None:
    print(validate_rtdetr(args.source.resolve()))


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    commands = root.add_subparsers(dest="command", required=True)
    status_parser = commands.add_parser("status")
    status_parser.set_defaults(handler=status)
    prepare_parser = commands.add_parser("prepare")
    prepare_parser.add_argument(
        "--model-profile", choices=("auto",) + PUBLIC_PROFILES, default="auto"
    )
    prepare_parser.add_argument(
        "--execution-provider", choices=("cuda", "migraphx", "rocm", "cpu"), required=True
    )
    prepare_parser.set_defaults(handler=prepare)
    model_parser = commands.add_parser("import-model")
    model_parser.add_argument("--profile", choices=tuple(MODEL_PATHS), required=True)
    model_parser.add_argument("--source", type=Path, required=True)
    model_parser.set_defaults(handler=import_model)
    dataset_parser = commands.add_parser("import-r2b")
    dataset_parser.add_argument("--source", type=Path, required=True)
    dataset_parser.set_defaults(handler=import_r2b)
    build_parser = commands.add_parser("build-rtdetrv2-r50")
    build_parser.add_argument("--upstream-dir", type=Path, required=True)
    build_parser.add_argument("--checkpoint", type=Path, required=True)
    build_parser.set_defaults(handler=build_rtdetr)
    validate_parser = commands.add_parser("_validate-rtdetr", help=argparse.SUPPRESS)
    validate_parser.add_argument("--source", type=Path, required=True)
    validate_parser.set_defaults(handler=validate_command)
    return root


def main() -> int:
    args = parser().parse_args()
    try:
        args.handler(args)
    except (OSError, RuntimeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
