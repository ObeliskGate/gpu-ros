def import_rtdetr() -> None:
    source_text = os.environ.get("OVG_RTDETR_ONNX_SOURCE", "").strip()
    if not source_text:
        raise RuntimeError(
            "OVG_RTDETR_ONNX_SOURCE must point to a compatible RT-DETRv2 R50 ONNX file"
        )
    source = Path(source_text).expanduser()
    if source.is_symlink() or not source.is_file():
        raise RuntimeError(f"RT-DETRv2 ONNX source is not a regular file: {source}")

    destination = ASSETS_ROOT / RTDETR_MODEL_REL
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            dir=destination.parent,
            prefix=".rtdetrv2_r50vd_6x_coco.onnx.",
            delete=False,
        ) as stream:
            temporary = Path(stream.name)
        shutil.copyfile(source, temporary)
        with temporary.open("rb") as stream:
            os.fsync(stream.fileno())
        validate_rtdetr_model(temporary)
        temporary.replace(destination)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    print(f"installed RT-DETRv2 model: {destination}")
    print(f"SHA-256: {digest(destination)}")




def write_manifest() -> None:
    files = []
    for path in sorted(ASSETS_ROOT.rglob("*")):
        if path.is_file() and path.resolve() != MANIFEST.resolve():
            relative = path.relative_to(ASSETS_ROOT)
            entry = {
                "path": str(relative),
                "size": path.stat().st_size,
                "sha256": digest(path),
            }
            if relative == RTDETR_MODEL_REL:
                entry["asset_kind"] = "rtdetrv2"
                entry["identity"] = RTDETR_MODEL_IDENTITY
            if relative == YOLOV8_MODEL_REL:
                entry["asset_kind"] = "yolov8"
                entry["optional"] = True
                entry["identity"] = YOLOV8_MODEL_IDENTITY
            files.append(entry)
    payload = _default_manifest()
    payload["files"] = files
    _write_manifest_atomically(payload)


def record_yolov8_manifest(model: Path) -> None:
    if MANIFEST.is_file():
        try:
            payload = json.loads(MANIFEST.read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise RuntimeError(f"asset manifest is not valid JSON: {MANIFEST}") from error
        if not isinstance(payload, dict):
            raise RuntimeError(f"asset manifest must contain a JSON object: {MANIFEST}")
    else:
        payload = _default_manifest()

    entries = [
        entry
        for entry in payload.get("files", [])
        if isinstance(entry, dict) and not _is_yolov8_entry(entry)
    ]
    entries.append(
        {
            "path": str(YOLOV8_MODEL_REL),
            "size": model.stat().st_size,
            "sha256": YOLOV8_MODEL_SHA256,
            "asset_kind": "yolov8",
            "optional": True,
            "identity": YOLOV8_MODEL_IDENTITY,
        }
    )
    payload["schema_version"] = max(int(payload.get("schema_version", 1)), 2)
    payload["generated_at"] = datetime.now(timezone.utc).isoformat()
    payload["optional_assets"] = {
        **payload.get("optional_assets", {}),
        "yolov8": {
            "path": str(YOLOV8_MODEL_REL),
            "sha256": YOLOV8_MODEL_SHA256,
            "identity": YOLOV8_MODEL_IDENTITY,
        },
    }
    payload["files"] = sorted(entries, key=lambda entry: str(entry.get("path", "")))
    _write_manifest_atomically(payload)


def import_yolov8() -> None:
    source_text = os.environ.get("OVG_YOLOV8_ONNX_SOURCE", "").strip()
    if not source_text:
        raise RuntimeError(
            "OVG_YOLOV8_ONNX_SOURCE must point to a user-provided YOLOv8 ONNX file"
        )
    source = Path(source_text).expanduser()
    if source.is_symlink() or not source.is_file():
        raise RuntimeError(f"YOLOv8 ONNX source is not a regular file: {source}")

    source_sha256 = digest(source)
    if source_sha256 != YOLOV8_MODEL_SHA256:
        raise RuntimeError(
            "YOLOv8 ONNX SHA-256 mismatch: "
            f"{source_sha256}; expected {YOLOV8_MODEL_SHA256}"
        )

    destination = yolo_model_path()
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            dir=destination.parent, prefix=".yolov8s.onnx.", delete=False
        ) as stream:
            temporary = Path(stream.name)
        shutil.copyfile(source, temporary)
        with temporary.open("rb") as stream:
            os.fsync(stream.fileno())
        if digest(temporary) != YOLOV8_MODEL_SHA256:
            raise RuntimeError("temporary YOLOv8 ONNX copy failed SHA-256 verification")
        validate_yolov8_model(temporary)
        temporary.replace(destination)
        temporary = None
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)

    record_yolov8_manifest(destination)
    print(f"installed optional YOLOv8 model: {destination}")
    print(f"SHA-256: {YOLOV8_MODEL_SHA256}")


def verify_yolov8() -> None:
    model = yolo_model_path()
    model_sha256 = validate_yolov8_model(model)
    if MANIFEST.is_file():
        try:
            data = json.loads(MANIFEST.read_text())
        except (OSError, json.JSONDecodeError) as error:
            raise RuntimeError(f"asset manifest is not valid JSON: {MANIFEST}") from error
        if not isinstance(data, dict):
            raise RuntimeError(f"asset manifest must contain a JSON object: {MANIFEST}")
        optional_assets = data.get("optional_assets", {})
        optional_asset = (
            optional_assets.get("yolov8")
            if isinstance(optional_assets, dict)
            else None
        )
        if optional_asset is not None:
            if not isinstance(optional_asset, dict) or optional_asset.get("path") != str(
                YOLOV8_MODEL_REL
            ):
                raise RuntimeError(
                    f"YOLOv8 optional manifest path mismatch: {MANIFEST}"
                )
            if optional_asset.get("identity") not in (None, YOLOV8_MODEL_IDENTITY):
                raise RuntimeError(
                    f"YOLOv8 optional manifest identity mismatch: {MANIFEST}"
                )
            if optional_asset.get("sha256") not in (None, model_sha256):
                raise RuntimeError(
                    f"YOLOv8 optional manifest checksum mismatch: {MANIFEST}"
                )
        for entry in data.get("files", []):
            if not isinstance(entry, dict) or not _is_yolov8_entry(entry):
                continue
            if entry.get("sha256") != model_sha256:
                raise RuntimeError(
                    f"YOLOv8 optional manifest checksum mismatch: {MANIFEST}"
                )
            if entry.get("identity") not in (None, YOLOV8_MODEL_IDENTITY):
                raise RuntimeError(
                    f"YOLOv8 optional manifest identity mismatch: {MANIFEST}"
                )
            break
    print(f"verified YOLOv8 model: {model}")
    print(f"SHA-256: {model_sha256}")


def replace_symlink(path: Path, target: str) -> None:
    if path.exists() and not path.is_symlink():
        raise RuntimeError(f"refusing to replace existing directory with symlink: {path}")
    path.unlink(missing_ok=True)
    path.symlink_to(target)




def verify() -> None:
    if not MANIFEST.is_file():
        raise RuntimeError("asset manifest is missing; supply a manifest with the separately licensed external assets")
    data = json.loads(MANIFEST.read_text())
    if not isinstance(data, dict):
        raise RuntimeError(f"asset manifest must contain a JSON object: {MANIFEST}")
    model = ASSETS_ROOT / RTDETR_MODEL_REL
    dataset = ASSETS_ROOT / DATASET_REL
    if not model.is_file():
        raise RuntimeError(f"missing required RT-DETR model: {model}")
    validate_rtdetr_model(model)
    if not dataset.is_dir():
        raise RuntimeError(f"missing required R2B dataset: {dataset}")
    required_entries = _required_manifest_entries(data)
    for entry in required_entries:
        path = ASSETS_ROOT / entry["path"]
        if not path.is_file():
            raise RuntimeError(f"missing asset file: {path}")
        if path.stat().st_size != entry["size"] or digest(path) != entry["sha256"]:
            raise RuntimeError(f"asset checksum mismatch: {path}")
        if (
            entry.get("asset_kind") == "rtdetrv2"
            and entry.get("identity") != RTDETR_MODEL_IDENTITY
        ):
            raise RuntimeError(f"RT-DETRv2 model identity mismatch: {MANIFEST}")
    print(f"verified {len(required_entries)} required asset files")
    status()


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command",
        choices=('status', 'verify', 'import-rtdetr', 'import-yolov8', 'verify-yolov8'),
    )
    args = parser.parse_args()
    try:
        {'status': status, 'verify': verify, 'import-rtdetr': import_rtdetr, 'import-yolov8': import_yolov8, 'verify-yolov8': verify_yolov8}[args.command]()
    except (OSError, RuntimeError, urllib.error.URLError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
