#!/usr/bin/env bash
set -euo pipefail
trap 'echo "ERROR: phase2 command failed at line ${LINENO}: ${BASH_COMMAND}" >&2' ERR

WORKSPACE_ROOT="${OVG_WORKSPACE_ROOT:-/workspaces/gpu-ros}"
ASSETS_ROOT="${OVG_ASSETS_ROOT:-/workspaces/ovg-assets}"
CACHE_ROOT="${OVG_CACHE_ROOT:-/workspaces/ovg-cache}"
RESULTS_ROOT="${OVG_RESULTS_ROOT:-/workspaces/ovg-results}"
ASSET_HELPER="${WORKSPACE_ROOT}/tools/phase2-assets"

source_setup() {
  set +u
  # shellcheck disable=SC1090
  source "$1"
  set -u
}

source_setups() {
  if [[ -n "${ROS_DISTRO:-}" && -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]]; then
    source_setup "/opt/ros/${ROS_DISTRO}/setup.bash"
  fi
  if [[ -f /opt/ros2_benchmark/setup.bash ]]; then
    source_setup /opt/ros2_benchmark/setup.bash
  fi
  # The NVIDIA TensorList interface is resolved only by the explicit
  # NVIDIA compatibility/reference profile. Do not source its
  # standalone workspace in the canonical AMD entrypoint.
  if [[ -f "${WORKSPACE_ROOT}/install/setup.bash" ]]; then
    source_setup "${WORKSPACE_ROOT}/install/setup.bash"
  fi
}

detect_gfx() {
  if command -v rocminfo >/dev/null 2>&1; then
    rocminfo 2>/dev/null \
      | awk '$1 == "Name:" && $2 ~ /^gfx[0-9]/ {print $2}' \
      | sort -u \
      | paste -sd, -
  fi
}

verify_manifest_targets() {
  if [[ -n "${OVG_ORT_ROOT:-}" ]]; then
    verify_external_ort_targets
    return
  fi
  local expected=""
  if [[ -f /opt/ovg/image-manifest.json ]]; then
    expected="$(python3 - <<'PY'
import json
from pathlib import Path
print(json.loads(Path('/opt/ovg/image-manifest.json').read_text()).get('gpu_targets', ''))
PY
)"
  fi
  [[ -z "${expected}" ]] && return 0
  local actual="$(detect_gfx)"
  local target
  while IFS= read -r target; do
    [[ -z "${target}" ]] && continue
    tr ',' '\n' <<<"${expected}" | grep -Fxq "${target}" || {
      echo "ERROR: runtime gfx ${target} is not included in image targets ${expected}" >&2
      return 1
    }
  done < <(tr ',' '\n' <<<"${actual}")
}

require_external_ort() {
  [[ -n "${OVG_ORT_ROOT:-}" ]] || {
    echo "ERROR: external ORT is required for every AMD build/validation run; /opt/onnxruntime in the SIF is legacy build-only content" >&2
    return 1
  }
}

verify_external_ort_targets() {
  local root="${OVG_ORT_ROOT%/}"
  local build_info="${root}/build-info.txt"
  [[ -f "${build_info}" ]] || {
    echo "ERROR: external ORT build-info.txt is missing: ${build_info}" >&2
    return 1
  }

  local expected
  expected="$(awk -F= '$1 == "gpu_targets" {print $2; exit}' "${build_info}")"
  [[ -n "${expected}" ]] || {
    echo "ERROR: external ORT build-info.txt has no gpu_targets: ${build_info}" >&2
    return 1
  }

  local actual="$(detect_gfx)"
  local target
  while IFS= read -r target; do
    [[ -z "${target}" ]] && continue
    tr ',;' '\n' <<<"${expected}" | grep -Fxq "${target}" || {
      echo "ERROR: runtime gfx ${target} is not included in external ORT targets ${expected}" >&2
      return 1
    }
  done < <(tr ',;' '\n' <<<"${actual}")
}

show_hip_environment() {
  local rocm_root="${OVG_ROCM_ROOT:-${hip_ROOT:-}}"
  local hip_config=""
  if [[ -n "${rocm_root}" ]]; then
    hip_config="${rocm_root}/lib/cmake/hip/hip-config.cmake"
  fi
  echo "COLCON_DEFAULTS_FILE: ${COLCON_DEFAULTS_FILE:-unknown} ($([[ -f "${COLCON_DEFAULTS_FILE:-}" ]] && echo present || echo missing))"
  echo "OVG_ROCM_ROOT: ${OVG_ROCM_ROOT:-unresolved}"
  echo "hip_ROOT: ${hip_ROOT:-unresolved}"
  echo "HIP CMake config: ${hip_config:-unresolved} ($([[ -n "${hip_config}" && -f "${hip_config}" ]] && echo present || echo missing))"
}

show_env() {
  source_setups
  local ort="${ONNXRUNTIME_LIBRARY:-/opt/onnxruntime/lib/libonnxruntime.so}"
  local rocm_root="${OVG_ROCM_ROOT:-${hip_ROOT:-}}"
  echo "runtime: ${OVG_RUNTIME_EFFECTIVE:-${OVG_RUNTIME:-unknown}}"
  echo "ROS_DISTRO: ${ROS_DISTRO:-unknown}"
  echo "ROCm: $(cat "${rocm_root:-/opt/rocm}/.info/version" 2>/dev/null || echo unknown)"
  echo "GPU gfx: $(detect_gfx || true)"
  echo "/dev/kfd: $([[ -e /dev/kfd ]] && echo available || echo unavailable)"
  echo "/dev/dri: $([[ -d /dev/dri ]] && find /dev/dri -maxdepth 1 -name 'renderD*' -printf '%f ' || true)"
  echo "ONNXRUNTIME_ROOT: ${ONNXRUNTIME_ROOT:-unknown}"
  echo "OVG_ORT_ROOT: ${OVG_ORT_ROOT:-unset (external ORT required; builtin /opt/onnxruntime is build-only)}"
  if [[ -n "${OVG_ORT_ROOT:-}" ]]; then
    echo "external ORT fingerprint: $(cat "${OVG_ORT_ROOT%/}/.ovg-ort-fingerprint" 2>/dev/null || echo unknown)"
    echo "external ORT GPU targets: $(awk -F= '$1 == "gpu_targets" {print $2; exit}' "${OVG_ORT_ROOT%/}/build-info.txt" 2>/dev/null || echo unknown)"
  fi
  echo "OVG_WORKSPACE_FINGERPRINT: ${OVG_WORKSPACE_FINGERPRINT:-unknown}"
  echo "ORT library: ${ort} ($([[ -f "${ort}" ]] && echo present || echo missing))"
  echo "MIGraphX provider: $(find "$(dirname "${ort}")" -maxdepth 1 -name '*migraphx*.so*' -printf '%f ' 2>/dev/null || true)"
  echo "workspace: ${WORKSPACE_ROOT}"
  show_hip_environment
  echo "assets: ${ASSETS_ROOT}"
  echo "cache: ${ORT_MIGRAPHX_MODEL_CACHE_PATH:-${CACHE_ROOT}/migraphx}"
  echo "results: ${RESULTS_ROOT}"
  echo "image manifest: $(cat /opt/ovg/image-manifest.json 2>/dev/null || echo unavailable)"
  echo "monorepo commit: $(git -C "${WORKSPACE_ROOT}" rev-parse HEAD 2>/dev/null || echo unavailable)"
  echo "workspace build: $([[ -f "${WORKSPACE_ROOT}/install/setup.bash" ]] && echo present || echo absent)"
  if command -v ros2 >/dev/null 2>&1; then
    echo "ROS packages:"
    ros2 pkg list 2>/dev/null \
      | grep -E '^(gpu_ros_managed_|gpu_ros_(detection|onnx|rtdetr|yolov8|tensor_bundle|nvidia_tensor))' \
      | sort || true
  fi
}

verify_colcon_profile() {
  local expected="${WORKSPACE_ROOT}/docker/colcon-defaults-phase2a-amd.yaml"
  [[ "${COLCON_DEFAULTS_FILE:-}" == "${expected}" ]] || {
    echo "ERROR: COLCON_DEFAULTS_FILE is not the canonical AMD profile: ${COLCON_DEFAULTS_FILE:-unset}" >&2
    return 1
  }
  [[ -f "${expected}" ]] || {
    echo "ERROR: canonical AMD colcon defaults file is missing: ${expected}" >&2
    return 1
  }
}

verify_hip_environment() {
  local rocm_root="${OVG_ROCM_ROOT:-}"
  local hip_root="${hip_ROOT:-}"
  [[ -n "${rocm_root}" && -n "${hip_root}" ]] || {
    echo "ERROR: HIP/ROCm root was not resolved by the AMD entrypoint" >&2
    return 1
  }
  [[ "${rocm_root}" == "${hip_root}" ]] || {
    echo "ERROR: OVG_ROCM_ROOT and hip_ROOT disagree: ${rocm_root} vs ${hip_root}" >&2
    return 1
  }
  [[ -f "${hip_root}/lib/cmake/hip/hip-config.cmake" ]] || {
    echo "ERROR: HIP CMake config is missing: ${hip_root}/lib/cmake/hip/hip-config.cmake" >&2
    return 1
  }
}

verify_env() {
  require_external_ort
  show_env
  verify_colcon_profile
  verify_hip_environment
  [[ -e /dev/kfd ]] || { echo "ERROR: /dev/kfd is not accessible" >&2; return 1; }
  [[ -d /dev/dri ]] || { echo "ERROR: /dev/dri is not accessible" >&2; return 1; }
  [[ -n "$(detect_gfx)" ]] || { echo "ERROR: rocminfo reported no gfx target" >&2; return 1; }
  verify_manifest_targets
  local ort="${ONNXRUNTIME_LIBRARY:-/opt/onnxruntime/lib/libonnxruntime.so}"
  [[ -f "${ort}" ]] || { echo "ERROR: ONNX Runtime library is missing: ${ort}" >&2; return 1; }
  find "$(dirname "${ort}")" -maxdepth 1 -name '*migraphx*.so*' -print -quit \
    | grep -q . || { echo "ERROR: MIGraphX provider library is missing" >&2; return 1; }
}

cache_status() {
  local cache="${ORT_MIGRAPHX_MODEL_CACHE_PATH:-${CACHE_ROOT}/migraphx}"
  mkdir -p "${cache}"
  echo "MIGraphX cache: ${cache}"
  find "${CACHE_ROOT}/migraphx" -mindepth 1 -maxdepth 2 -type d -print 2>/dev/null | sort || true
}

cache_clean() {
  [[ "${1:-}" == migraphx ]] || { echo "usage: phase2 cache clean migraphx" >&2; return 2; }
  local cache="${CACHE_ROOT}/migraphx"
  mkdir -p "${cache}"
  rm -rf -- "${cache}"/*
  echo "cleared MIGraphX cache entries under ${cache}"
}

build_workspace() {
  require_external_ort
  source_setups
  cd "${WORKSPACE_ROOT}"
  echo "+ colcon build"
  colcon build
}

main() {
  local group="${1:-env}"
  case "${group}" in
    env)
      case "${2:-}" in
        '') show_env ;;
        --verify) verify_env ;;
        *) echo "usage: phase2 env [--verify]" >&2; return 2 ;;
      esac ;;
    assets)
      case "${2:-status}" in
        status|prepare|import-model|import-r2b|build-rtdetrv2-r50)
          "${ASSET_HELPER}" "${2:-status}" "${@:3}" ;;
        *)
          echo "usage: phase2 assets {status|prepare|import-model|import-r2b|build-rtdetrv2-r50} [options]" >&2
          return 2
          ;;
      esac ;;
    cache)
      case "${2:-status}" in
        status) cache_status ;;
        clean) cache_clean "${3:-}" ;;
        *) echo "usage: phase2 cache {status|clean migraphx}" >&2; return 2 ;;
      esac ;;
    build) build_workspace ;;
    *) echo "this helper only provides env, assets, cache and build" >&2; return 2 ;;
  esac
}

main "$@"
