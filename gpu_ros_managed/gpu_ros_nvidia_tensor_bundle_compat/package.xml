<?xml version="1.0"?>
<package format="3">
  <name>gpu_ros_nvidia_tensor_bundle_compat</name>
  <version>0.1.0</version>
  <description>NVIDIA-only boundary adapter between TensorList and TensorBundle.</description>
  <maintainer email="unnamets@gmail.com">Boshen Chen</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>isaac_ros_tensor_msgs</depend>
  <depend>tensor_msgs</depend>
  <depend>gpu_ros_tensor_bundle_msgs</depend>
  <depend>rosidl_buffer</depend>
  <depend>cuda_buffer</depend>
  <exec_depend>cuda_buffer_backend</exec_depend>
  <depend>gpu_ros_managed_core</depend>
  <depend>gpu_ros_managed_cuda</depend>
  <depend>gpu_ros_managed_ros</depend>
  <depend>gpu_ros_managed_tensor_bundle</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
